<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <EdirstatNativeRoot>$(MSBuildThisFileDirectory)..\Edirstat.Native</EdirstatNativeRoot>
    <EdirstatNativeLibrary>$(EdirstatNativeRoot)\target\x86_64-pc-windows-msvc\release\edirstat_bridge.dll</EdirstatNativeLibrary>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.343" PrivateAssets="all" ExcludeAssets="runtime" />
    <None Include="$(EdirstatNativeLibrary)" Link="edirstat_bridge.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(EdirstatNativeRoot)\LICENSE.edirstat" Link="LICENSE.edirstat" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(EdirstatNativeRoot)\README.md" Link="EDIRSTAT.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildEdirstatNative" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(EdirstatNativeRoot)" Command="cargo build --locked --release --package edirstat-bridge --target x86_64-pc-windows-msvc" />
    <Error Condition="!Exists('$(EdirstatNativeLibrary)')" Text="Rust build did not produce the Windows x64 scanner DLL." />
  </Target>
</Project>
